<Window x:Class="KomariDeskWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Komari Desk Widget" Width="360" Height="520" MinWidth="300" MinHeight="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        MouseLeftButtonDown="DragWindow">
  <Window.Resources>
    <Style x:Key="TinyButton" TargetType="Button">
      <Setter Property="Foreground" Value="#DCE7FF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="24" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>
  <Border Background="#E91B2130" BorderBrush="#667B8CA8" BorderThickness="1" CornerRadius="16" Padding="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel LastChildFill="False">
        <StackPanel>
          <TextBlock Text="KOMARI" Foreground="#DCE7FF" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Text="VPS 状态" Foreground="#8FA4C8" FontSize="11" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Style="{StaticResource TinyButton}" Content="↻" Click="Refresh" ToolTip="立即刷新" />
          <Button Style="{StaticResource TinyButton}" Content="—" Click="Minimize" ToolTip="最小化" />
          <Button Style="{StaticResource TinyButton}" Content="×" Click="Close" ToolTip="关闭" />
        </StackPanel>
      </DockPanel>
      <ScrollViewer Grid.Row="1" Margin="0,12,0,8" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Servers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#8A293246" CornerRadius="12" Padding="11" Margin="0,0,0,8">
                <StackPanel>
                  <DockPanel>
                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="235" />
                    <TextBlock Text="{Binding State}" Foreground="{Binding StateColor}" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" />
                  </DockPanel>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <TextBlock Text="CPU" Foreground="#AFC0DE" FontSize="11" />
                    <ProgressBar Grid.Column="1" Height="6" Maximum="100" Value="{Binding Cpu}" Margin="6,4" />
                    <TextBlock Grid.Column="2" Text="{Binding CpuText}" Foreground="#DCE7FF" FontSize="11" TextAlignment="Right" />
                  </Grid>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <TextBlock Text="内存" Foreground="#AFC0DE" FontSize="11" />
                    <ProgressBar Grid.Column="1" Height="6" Maximum="100" Value="{Binding Ram}" Margin="6,4" />
                    <TextBlock Grid.Column="2" Text="{Binding RamText}" Foreground="#DCE7FF" FontSize="11" TextAlignment="Right" />
                  </Grid>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <TextBlock Text="硬盘" Foreground="#AFC0DE" FontSize="11" />
                    <ProgressBar Grid.Column="1" Height="6" Maximum="100" Value="{Binding Disk}" Margin="6,4" />
                    <TextBlock Grid.Column="2" Text="{Binding DiskText}" Foreground="#DCE7FF" FontSize="11" TextAlignment="Right" />
                  </Grid>
                  <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding UploadText}" Foreground="#8FE6C2" FontSize="11" />
                    <TextBlock Text="{Binding DownloadText}" Foreground="#95C9FF" FontSize="11" DockPanel.Dock="Right" />
                  </DockPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Text="{Binding Footer}" Foreground="#8395B5" FontSize="10" HorizontalAlignment="Right" />
    </Grid>
  </Border>
</Window>
