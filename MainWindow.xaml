<Window x:Class="KomariDeskWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Komari Desk Widget" Width="390" Height="540" MinWidth="390" MinHeight="370"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        Icon="assets/app.ico" MouseLeftButtonDown="DragWindow">
  <Window.Resources>
    <Style x:Key="TinyButton" TargetType="Button">
      <Setter Property="Foreground" Value="#EEF5FF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="24" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="Foreground" Value="#22C55E" />
      <Setter Property="Background" Value="#D8E0EC" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </Window.Resources>
  <Border Background="#E82B3446" BorderBrush="#7B9AB1CC" BorderThickness="1" CornerRadius="18" Padding="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel LastChildFill="False">
        <StackPanel>
          <TextBlock Text="KOMARI" Foreground="#F8FBFF" FontWeight="Bold" FontSize="16" />
          <TextBlock Text="VPS 状态" Foreground="#B9C6D8" FontSize="11" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Style="{StaticResource TinyButton}" Content="↻" Click="Refresh" ToolTip="立即刷新" />
          <Button Style="{StaticResource TinyButton}" Content="⚙" Click="OpenSettings" ToolTip="设置" />
          <Button Style="{StaticResource TinyButton}" Content="{Binding LockButtonText}" Background="{Binding LockButtonBackground}" Foreground="{Binding LockButtonForeground}" Width="34" FontWeight="Bold" Click="ToggleLock" ToolTip="{Binding LockButtonTip}" />
          <Button Style="{StaticResource TinyButton}" Content="—" Click="Minimize" ToolTip="最小化" />
          <Button Style="{StaticResource TinyButton}" Content="×" Click="Close" ToolTip="关闭" />
        </StackPanel>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,12,0,8">
        <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Servers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#C8DDE8F7" BorderBrush="#86FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{Binding StateColor}" FontSize="12" FontWeight="Bold" Margin="8,1,0,0" />
                    </Grid>
                    <Separator Margin="0,12,0,10" Background="#80FFFFFF" />
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                      <TextBlock Text="{Binding CoreText}" Foreground="#263445" FontSize="11" />
                      <TextBlock Text="{Binding RamUsedText}" Foreground="#263445" FontSize="11" TextAlignment="Center" />
                      <TextBlock Text="{Binding DiskUsedText}" Foreground="#263445" FontSize="11" TextAlignment="Right" />
                    </UniformGrid>
                    <Grid Margin="0,5,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                      <TextBlock Text="CPU" Foreground="#1F2937" FontSize="12" />
                      <ProgressBar Grid.Column="1" Maximum="100" Value="{Binding Cpu}" Margin="6,4" />
                      <TextBlock Grid.Column="2" Text="{Binding CpuText}" Foreground="#111827" FontSize="12" TextAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,9,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                      <TextBlock Text="内存" Foreground="#1F2937" FontSize="12" />
                      <ProgressBar Grid.Column="1" Maximum="100" Value="{Binding Ram}" Margin="6,4" />
                      <TextBlock Grid.Column="2" Text="{Binding RamText}" Foreground="#111827" FontSize="12" TextAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,9,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                      <TextBlock Text="硬盘" Foreground="#1F2937" FontSize="12" />
                      <ProgressBar Grid.Column="1" Maximum="100" Value="{Binding Disk}" Margin="6,4" />
                      <TextBlock Grid.Column="2" Text="{Binding DiskText}" Foreground="#111827" FontSize="12" TextAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="网络" Foreground="#1F2937" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding NetworkText}" Foreground="#111827" FontSize="11" TextAlignment="Right" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Grid x:Name="SettingsPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="设置" Foreground="#F8FBFF" FontWeight="Bold" FontSize="15" />
              <TextBlock Text="修改置顶、锁定、刷新间隔和展示节点" Foreground="#B9C6D8" FontSize="11" />
            </StackPanel>
            <Button Content="返回" DockPanel.Dock="Right" Width="58" Height="26" Click="CloseSettings" />
          </DockPanel>
          <Border Grid.Row="1" Background="#35DDE8F7" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Komari 面板地址" Foreground="#EEF5FF" FontWeight="SemiBold" />
              <TextBox x:Name="EndpointBox" Margin="0,6,0,10" Height="28" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="刷新间隔（秒）" Foreground="#EEF5FF" FontWeight="SemiBold" />
                  <TextBox x:Name="RefreshBox" Margin="0,6,8,0" Height="28" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                  <CheckBox x:Name="TopmostBox" Content="窗口始终置顶" Foreground="#EEF5FF" Margin="0,0,0,7" />
                  <CheckBox x:Name="LockedBox" Content="锁定窗口移动" Foreground="#EEF5FF" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Background="#35DDE8F7" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel>
                <StackPanel>
                  <TextBlock Text="展示节点" Foreground="#EEF5FF" FontWeight="SemiBold" />
                  <TextBlock Text="勾选要显示的节点；全选会按全部节点展示。" Foreground="#B9C6D8" FontSize="11" />
                </StackPanel>
                <Button Content="刷新节点" DockPanel.Dock="Right" Width="76" Height="28" Click="RefreshNodes" />
              </DockPanel>
              <ListBox x:Name="NodeList" Grid.Row="1" Margin="0,10,0,8" BorderBrush="#55FFFFFF" Background="#66F8FAFC" ItemsSource="{Binding Nodes}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" Margin="4" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <DockPanel Grid.Row="2">
                <TextBlock x:Name="SettingsStatusText" Foreground="#B9C6D8" VerticalAlignment="Center" FontSize="11" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                  <Button Content="全选" Width="54" Height="26" Margin="0,0,8,0" Click="SelectAllNodes" />
                  <Button Content="全不选" Width="64" Height="26" Click="SelectNoNodes" />
                </StackPanel>
              </DockPanel>
            </Grid>
          </Border>
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Width="70" Height="30" Margin="0,0,8,0" Click="CloseSettings" />
            <Button Content="保存" Width="78" Height="30" Background="#2563EB" Foreground="White" Click="SaveInlineSettings" />
          </StackPanel>
        </Grid>
      </Grid>
      <Grid Grid.Row="2">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <TextBlock Text="{Binding VersionText}" Foreground="#B9C6D8" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Content="检查更新" Foreground="#EEF5FF" Background="Transparent" BorderBrush="Transparent" FontSize="10" Padding="0" Click="CheckUpdates" />
        </StackPanel>
        <TextBlock Text="{Binding Footer}" Foreground="#B9C6D8" FontSize="10" HorizontalAlignment="Right" Margin="0,0,16,0" />
        <primitives:Thumb Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" DragDelta="ResizeWindow" Cursor="SizeNWSE" Opacity="0.7" Margin="0,0,-6,-6">
          <primitives:Thumb.Template>
            <ControlTemplate TargetType="{x:Type primitives:Thumb}">
              <Grid Background="Transparent">
                <Path Stroke="#B9C6D8" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" Data="M 4 14 L 14 4 M 8 14 L 14 8 M 12 14 L 14 12" />
              </Grid>
            </ControlTemplate>
          </primitives:Thumb.Template>
        </primitives:Thumb>
      </Grid>
    </Grid>
  </Border>
</Window>
