<Window x:Class="KomariDeskWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="460" Height="560" MinWidth="420" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
  <Border Background="#F8FAFC" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="Komari Desk Widget 设置" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="可在这里关闭窗口置顶、调整刷新间隔，并选择要展示的节点。" Margin="0,6,0,0" Foreground="#64748B" TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,16,0,12">
        <StackPanel>
          <TextBlock Text="Komari 面板地址" Foreground="#334155" FontWeight="SemiBold" />
          <TextBox x:Name="EndpointBox" Margin="0,6,0,12" Height="30" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="刷新间隔（秒）" Foreground="#334155" FontWeight="SemiBold" />
              <TextBox x:Name="RefreshBox" Margin="0,6,8,0" Height="30" />
            </StackPanel>
            <CheckBox x:Name="TopmostBox" Grid.Column="1" Content="窗口始终置顶" VerticalAlignment="Bottom" Margin="8,0,0,6" Foreground="#334155" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel>
            <StackPanel>
              <TextBlock Text="展示节点" Foreground="#334155" FontWeight="SemiBold" />
              <TextBlock Text="勾选要显示的节点；如果全选，会按全部节点展示。" Foreground="#64748B" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
            <Button Content="刷新节点" DockPanel.Dock="Right" Width="86" Height="30" Click="RefreshNodes" />
          </DockPanel>

          <ListBox x:Name="NodeList" Grid.Row="1" Margin="0,12,0,10" BorderBrush="#CBD5E1" ItemsSource="{Binding Nodes}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" Margin="4" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <DockPanel Grid.Row="2">
            <TextBlock x:Name="StatusText" Foreground="#64748B" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Content="全选" Width="62" Height="28" Margin="0,0,8,0" Click="SelectAll" />
              <Button Content="全不选" Width="72" Height="28" Click="SelectNone" />
            </StackPanel>
          </DockPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="取消" Width="82" Height="32" Margin="0,0,10,0" Click="Cancel" />
        <Button Content="保存" Width="92" Height="32" Background="#2563EB" Foreground="White" Click="Save" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
